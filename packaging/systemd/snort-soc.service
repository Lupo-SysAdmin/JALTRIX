[Unit]
Description=Snort SOC managed passive sensor
Documentation=https://www.snort.org/
After=network-online.target
Wants=network-online.target
ConditionFileIsExecutable=/usr/local/lib/snort-soc-engine/bin/snort
ConditionPathExists=/etc/snort-soc/snort.lua

[Service]
Type=simple
User=snort-soc
Group=snort-soc
Environment=SNORT_CHECKSUM=all
EnvironmentFile=/etc/snort-soc/sensor.env
ExecStartPre=/usr/local/lib/snort-soc-engine/bin/snort -T -c /etc/snort-soc/snort.lua -R /etc/snort-soc/local.rules -l /var/log/snort-soc
ExecStart=/usr/local/lib/snort-soc-engine/bin/snort -c /etc/snort-soc/snort.lua -R /etc/snort-soc/local.rules -i ${SNORT_INTERFACE} --daq afpacket --daq-mode passive --daq-batch-size 1 -A alert_json -l /var/log/snort-soc -U -k ${SNORT_CHECKSUM}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
LogsDirectory=snort-soc
LogsDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
ReadWritePaths=/var/log/snort-soc

[Install]
WantedBy=multi-user.target
